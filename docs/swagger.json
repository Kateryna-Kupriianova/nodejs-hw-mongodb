{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Phonebook",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "<опис вашого додатку>"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    },
    {
      "url": ""
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations about contacts."
    },
    {
      "name": "Auth",
      "description": "Auth operations."
    }
  ],
  "paths": {
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get contact by id",
        "description": "Get contact by id",
        "operationId": "getContactById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of contact to return",
            "required": true,
            "schema": {
              "type": "string",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stutus",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "stutus": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contact with id 1"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stutus",
                    "message"
                  ],
                  "properties": {
                    "stutus": {
                      "type": "integer",
                      "example": 404
                    },
                    "message": {
                      "type": "string",
                      "example": "Contact with id 1 not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "email",
          "contactType",
          "userId",
          "photo",
          "isFavourite"
        ],
        "properties": {
          "_id": {
            "description": "Contact`s id",
            "type": "string",
            "example": 1
          },
          "name": {
            "description": "Contact`s name",
            "type": "string",
            "example": "John Doe"
          },
          "phoneNumber": {
            "description": "Contact`s phone number",
            "type": "string",
            "example": 380123456789
          },
          "email": {
            "description": "Contact`s email",
            "type": "string",
            "example": "0xYtJ@example.com"
          },
          "contactType": {
            "description": "Contact`s type",
            "type": "string",
            "example": "personal"
          },
          "userId": {
            "description": "User`s id",
            "type": "string",
            "example": 1
          },
          "photo": {
            "description": "Contact`s photo",
            "type": "string",
            "example": "https://example.com/photo.png",
            "default": null
          },
          "isFavourite": {
            "description": "Is contact favourite",
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}